# Base Postgres Neon (projet « equipe-urra-rauda »). Obligatoire : chaque demande y est enregistrée.
DATABASE_URL=

# Liens publics de réservation fournis par l'application séparée Calnode.
# La demande est enregistrée avant la redirection. Aucune coordonnée n'est ajoutée à l'URL.
CALNODE_BOOKING_URL=
CALNODE_PAULINA_BOOKING_URL=
CALNODE_DENIS_BOOKING_URL=
# Interface privée Calnode (lien affiché dans le back-office).
CALNODE_ADMIN_URL=

# Ancienne variable, acceptée comme lien de réservation par défaut.
RDV_URL=

# Optionnel : webhook (CRM, Zapier, Make…) qui reçoit aussi les réponses du questionnaire en JSON.
LEAD_WEBHOOK_URL=
