# Base Postgres Neon (projet « equipe-urra-rauda »). Obligatoire : chaque demande y est enregistrée.
DATABASE_URL=

# Agenda Meetlyio : à la fin du questionnaire, le client choisit son appel directement sur le site.
# Adresse de l'espace Meetlyio de l'équipe, ex. : https://urra-rauda.meetlyio.makers-tech.ca
# Sert aussi au lien « Agenda Meetlyio » du back-office. Vide : le client voit « Paulina ou Denis vous contactera ».
MEETLYIO_URL=
# Identifiant du rendez-vous d'équipe en tourniquet (Meetlyio → Event types), ex. : appel-30-min.
# Meetlyio propose les créneaux libres de Paulina et Denis et attribue l'appel à l'un des deux.
MEETLYIO_TYPE=
# Secrets des webhooks Meetlyio (un par courtier : Paulina, Denis), séparés par une virgule.
# Le webhook pointe vers https://<adresse du site>/api/meetlyio. Il met à jour le dossier
# quand le client annule ou déplace son appel, ou quand l'appel change de courtier.
MEETLYIO_WEBHOOK_SECRET=

# Courriel envoyé à chaque nouvelle demande (service Resend, resend.com).
RESEND_API_KEY=
# Expéditeur sur un domaine vérifié dans Resend, ex. : Site Équipe Urra-Rauda <demandes@paulinaurra.com>
COURRIEL_EXPEDITEUR=
# Destinataires, séparés par des virgules.
COURRIEL_DESTINATAIRES=paulina.urra@remax-quebec.com,denis.raudahernandez@remax-quebec.com
# Adresse publique du site, pour le lien « Ouvrir le dossier » (Netlify fournit déjà URL automatiquement).
SITE_URL=

# Optionnel : webhook (CRM, Zapier, Make…) qui reçoit aussi les réponses du questionnaire en JSON.
LEAD_WEBHOOK_URL=
